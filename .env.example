# Public URL of the deployed site (used for canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry form: the site sends each enquiry by email through Gmail.
# GMAIL_USER is the Gmail address that sends the mail. It needs 2-step verification, and
# GMAIL_APP_PASSWORD is a 16-character App Password made for it (Google Account > Security >
# App passwords). Do not use the normal Gmail password. CONTACT_TO_EMAIL is where enquiries arrive.
# Put the real values in .env.local (never commit it) and in Vercel > Settings > Environment Variables.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

# YouTube (optional but recommended on the live site): a Google API key with "YouTube Data API v3"
# enabled (console.cloud.google.com > APIs & Services). YouTube often blocks its public RSS feed
# from cloud hosts, and this key makes the "Latest videos" list reliable. Free quota is plenty.
YOUTUBE_API_KEY=

# Website assistant (the chat button). Needs a Groq API key from console.groq.com/keys (free tier is enough).
# Without it the chat says it is unavailable and the rest of the site is unaffected. The model is
# openai/gpt-oss-120b unless GROQ_MODEL names another one.
GROQ_API_KEY=
GROQ_MODEL=
